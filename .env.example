# =============================================================================
# GenWrite Frontend - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# Only VITE_-prefixed vars are exposed to the client bundle — never put a
# secret key here, everything in this file ships to the browser.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Backend API origin. The axios instance appends /api/v1 itself, so no path here.
VITE_BACKEND_URL=http://localhost:8000

# This app's own origin, used to build shareable blog URLs.
VITE_FRONTEND_URL=http://localhost:5174

# Google OAuth client id (Google Cloud Console > Credentials).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Stripe publishable key — the pk_ one, never the secret sk_ key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# reCAPTCHA v2 site key, used on the login form.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# --- Contact form (EmailJS) --------------------------------------------------
# Required for the Contact Us page to send mail.

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# --- Optional flags ----------------------------------------------------------

# Log outgoing request payloads to the console (development aid).
VITE_DEBUG_PAYLOADS=false

# Enable extra client-side form validation in the blog creation modals.
VITE_VALIDATE_FORMS=true

# --- Optional: trial promo card on the login page ----------------------------
# Leave VITE_SHOW_TRIAL_CARD unset or false to hide the card entirely.

VITE_SHOW_TRIAL_CARD=false
VITE_TRIAL_BADGE_TEXT=Limited time
VITE_TRIAL_TEXT=Start your free trial
VITE_TRIAL_SUBTEXT=No credit card required
